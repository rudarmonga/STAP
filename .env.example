# STAP Environment Configuration
# Copy this file to .env and customize for your environment

# Environment: development, staging, or production
STAP_ENV=development

# Database path (relative or absolute)
# Default: data/stap.db in project root
# STAP_DATABASE_PATH=data/stap.db

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
STAP_LOG_LEVEL=INFO

# Optional: Log file path (if not set, logs to console only)
# STAP_LOG_FILE=logs/stap.log

# Seed for reproducible synthetic data generation
STAP_SYNTHETIC_DATA_SEED=42

# Application branding
STAP_APP_TITLE=STAP - Seller Trust Analytics Platform
STAP_PAGE_TITLE=STAP Analytics
